---
interface Props {
	cols?: number;
}

const { cols = 3 } = Astro.props;
---

<div class="gallery" style={`--cols: ${cols}`}>
	<slot />
</div>

<style>
	.gallery {
		display: grid;
		grid-template-columns: repeat(var(--cols), 1fr);
		gap: 1rem;
		margin: 1.5rem 0;
	}
	.gallery :global(img) {
		width: 100%;
		height: auto;
		border-radius: 4px;
	}
	@media (max-width: 768px) {
		.gallery {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 480px) {
		.gallery {
			grid-template-columns: 1fr;
		}
	}
</style>
