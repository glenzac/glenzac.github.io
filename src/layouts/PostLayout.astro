---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import Comments from '../components/Comments.astro';
import ArchivedComments from '../components/ArchivedComments.astro';
import FormattedDate from '../components/FormattedDate.astro';
import BackToTop from '../components/BackToTop.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { SITE_TITLE, SITE_AUTHOR } from '../consts';
import type { ImageMetadata } from 'astro';
import { postSlug } from '../utils/postSlug';

interface Props {
	title: string;
	date: Date;
	slug: string;
	categories?: string[];
	tags?: string[];
	cover?: {
		image: ImageMetadata;
		alt?: string;
	};
	description?: string;
	prevPost?: { id: string; data: { title: string } } | null;
	nextPost?: { id: string; data: { title: string } } | null;
	headings?: { depth: number; slug: string; text: string }[];
}

const { title, date, slug, categories = [], tags = [], cover, description = '', prevPost, nextPost, headings = [] } = Astro.props;

const content = await Astro.slots.render('default');
const wordCount = content.split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200);

const fullTitle = `${title} | ${SITE_TITLE}`;
const canonicalURL = new URL(`/posts/${slug}`, Astro.site).toString();

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description: description || title,
	datePublished: date.toISOString(),
	dateModified: date.toISOString(),
	author: { '@type': 'Person', name: SITE_AUTHOR },
	publisher: { '@type': 'Person', name: SITE_AUTHOR },
	url: canonicalURL,
	...(cover?.image && { image: new URL(cover.image.src, Astro.site).toString() }),
};
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<BaseHead title={fullTitle} description={description || title} image={cover?.image} ogType="article" />
		<meta property="article:published_time" content={date.toISOString()} />
		<meta property="article:author" content={SITE_AUTHOR} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<Header />
		<div class="page-wrapper">
			<main>
				<article class="post">
						<div class="hero-image">
							{cover && (
								<Image
									src={cover.image}
									alt={cover.alt || title}
									width={1200}
									height={600}
									loading="eager"
								/>
							)}
						</div>
					<header class="post-header">
						<div class="post-meta">
							<FormattedDate date={date} />
							<span class="separator">·</span>
							<span class="reading-time">{readingTime} min read</span>
						</div>
						<h1>{title}</h1>
						{categories.length > 0 && (
							<div class="categories">
								{categories.map(cat => (
									<a href={`/categories/${cat.toLowerCase()}`} class="category">{cat}</a>
								))}
							</div>
						)}
					</header>
					<TableOfContents headings={headings} />
					<div class="prose">
						<slot />
					</div>
					{tags.length > 0 && (
						<footer class="post-footer">
							<div class="tags">
								<span class="label">Tags:</span>
								{tags.map(tag => (
									<a href={`/tags/${tag.toLowerCase()}`} class="tag">{tag}</a>
								))}
							</div>
						</footer>
					)}
					{(prevPost || nextPost) && (
						<nav class="post-nav">
							<div class="post-nav-prev">
								{prevPost && (
									<a href={`/posts/${postSlug(prevPost.id)}`}>
										<span class="nav-label">← Older</span>
										<span class="nav-title">{prevPost.data.title}</span>
									</a>
								)}
							</div>
							<div class="post-nav-next">
								{nextPost && (
									<a href={`/posts/${postSlug(nextPost.id)}`}>
										<span class="nav-label">Newer →</span>
										<span class="nav-title">{nextPost.data.title}</span>
									</a>
								)}
							</div>
						</nav>
					)}
					<ArchivedComments slug={slug} />
					<Comments slug={slug} title={title} />
				</article>
				<Sidebar />
			</main>
		</div>
		<Footer />
		<BackToTop />
	</body>
</html>

<style>
	.page-wrapper {
		min-height: calc(100vh - 200px);
	}
	main {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1.5rem;
		display: flex;
		gap: 2rem;
	}
	article.post {
		flex: 1;
		min-width: 0;
	}
	.hero-image {
		margin-bottom: 2rem;
		border-radius: 8px;
		overflow: hidden;
	}
	.hero-image img {
		width: 100%;
		height: auto;
		max-height: 400px;
		object-fit: cover;
	}
	.post-header {
		margin-bottom: 2rem;
	}
	.post-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.9rem;
		color: var(--text-muted);
		margin-bottom: 0.75rem;
	}
	.separator {
		opacity: 0.5;
	}
	h1 {
		font-size: 2.25rem;
		font-weight: 700;
		line-height: 1.2;
		margin: 0 0 1rem 0;
		color: var(--text-primary);
	}
	.categories {
		display: flex;
		gap: 0.5rem;
	}
	.category {
		background: var(--accent);
		color: white;
		padding: 0.25rem 0.75rem;
		border-radius: 4px;
		font-size: 0.8rem;
		text-decoration: none;
		text-transform: capitalize;
	}
	.category:hover {
		opacity: 0.9;
	}
	.prose {
		font-size: 1.05rem;
		line-height: 1.8;
		color: var(--text-primary);
	}
	.prose :global(h2) {
		font-size: 1.5rem;
		margin-top: 2rem;
		margin-bottom: 1rem;
	}
	.prose :global(h3) {
		font-size: 1.25rem;
		margin-top: 1.5rem;
		margin-bottom: 0.75rem;
	}
	.prose :global(p) {
		margin-bottom: 1.25rem;
	}
	.prose :global(a) {
		color: var(--accent);
	}
	.prose :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: 4px;
		margin: 1rem 0;
	}
	.prose :global(pre) {
		background: var(--code-bg);
		padding: 1rem;
		border-radius: 8px;
		overflow-x: auto;
		margin: 1.5rem 0;
		position: relative;
	}
	.prose :global(.copy-btn) {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		padding: 0.25rem 0.6rem;
		background: var(--bg-tertiary);
		color: var(--text-muted);
		border: 1px solid var(--border-color);
		border-radius: 4px;
		font-size: 0.75rem;
		cursor: pointer;
		opacity: 0;
		transition: opacity 0.2s, background 0.2s;
	}
	.prose :global(pre:hover .copy-btn) {
		opacity: 1;
	}
	.prose :global(.copy-btn.copied) {
		background: var(--accent);
		color: white;
		border-color: var(--accent);
	}
	.prose :global(code) {
		font-family: 'Fira Code', 'Consolas', monospace;
		font-size: 0.9em;
	}
	.prose :global(blockquote) {
		border-left: 4px solid var(--accent);
		padding-left: 1rem;
		margin: 1.5rem 0;
		color: var(--text-secondary);
		font-style: italic;
	}
	.post-footer {
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border-color);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
	}
	.tags .label {
		font-size: 0.9rem;
		color: var(--text-secondary);
		margin-right: 0.5rem;
	}
	.tag {
		background: var(--bg-secondary);
		color: var(--text-secondary);
		padding: 0.25rem 0.75rem;
		border-radius: 15px;
		font-size: 0.8rem;
		text-decoration: none;
		transition: all 0.2s;
	}
	.tag:hover {
		background: var(--accent);
		color: white;
	}
	.post-nav {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border-color);
	}
	.post-nav-prev,
	.post-nav-next {
		flex: 1;
	}
	.post-nav-next {
		text-align: right;
	}
	.post-nav a {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		color: var(--text-secondary);
		text-decoration: none;
		transition: color 0.2s;
	}
	.post-nav a:hover {
		color: var(--accent);
	}
	.nav-label {
		font-size: 0.8rem;
		color: var(--text-muted);
	}
	.nav-title {
		font-size: 0.95rem;
		font-weight: 500;
		line-height: 1.4;
	}
	@media (max-width: 1024px) {
		main {
			flex-direction: column;
		}
	}
	@media (max-width: 768px) {
		h1 {
			font-size: 1.75rem;
		}
		.post-nav {
			flex-direction: column;
		}
		.post-nav-next {
			text-align: left;
		}
	}
</style>

<script is:inline>
	document.querySelectorAll('.prose pre').forEach(pre => {
		const btn = document.createElement('button');
		btn.className = 'copy-btn';
		btn.textContent = 'Copy';
		btn.addEventListener('click', async () => {
			const code = pre.querySelector('code')?.innerText ?? pre.innerText;
			await navigator.clipboard.writeText(code);
			btn.textContent = 'Copied!';
			btn.classList.add('copied');
			setTimeout(() => {
				btn.textContent = 'Copy';
				btn.classList.remove('copied');
			}, 2000);
		});
		pre.appendChild(btn);
	});
</script>
