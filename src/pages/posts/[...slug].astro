---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { postSlug } from '../../utils/postSlug';

export async function getStaticPaths() {
	const posts = await getCollection('posts', ({ data }) => !data.draft);
	const sorted = posts.sort((a, b) =>
		new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
	);

	// Related posts: shared tags weigh double shared categories.
	const related = (post) => {
		const tags = new Set((post.data.tags ?? []).map((t) => t.toLowerCase()));
		const cats = new Set((post.data.categories ?? []).map((c) => c.toLowerCase()));
		return sorted
			.filter((other) => other.id !== post.id)
			.map((other) => ({
				post: other,
				score:
					(other.data.tags ?? []).filter((t) => tags.has(t.toLowerCase())).length * 2 +
					(other.data.categories ?? []).filter((c) => cats.has(c.toLowerCase())).length,
			}))
			.filter(({ score }) => score > 0)
			.sort((a, b) => b.score - a.score || new Date(b.post.data.date).valueOf() - new Date(a.post.data.date).valueOf())
			.slice(0, 3)
			.map(({ post }) => post);
	};

	const pages = sorted.map((post, index) => ({
		params: { slug: postSlug(post.id) },
		props: {
			post,
			prevPost: sorted[index + 1] ?? null,
			nextPost: sorted[index - 1] ?? null,
			relatedPosts: related(post),
		},
	}));

	// Stubs at the old `<category>/<category>-<date>-<slug>` URLs that
	// meta-refresh to the clean slug, so previously indexed links keep working.
	const redirects = sorted
		.filter((post) => post.id !== postSlug(post.id))
		.map((post) => ({
			params: { slug: post.id },
			props: { redirectTo: `/posts/${postSlug(post.id)}/` },
		}));

	return [...pages, ...redirects];
}

const { post, prevPost, nextPost, relatedPosts, redirectTo } = Astro.props;
const rendered = redirectTo ? null : await render(post);
const Content = rendered?.Content;
---

{redirectTo ? (
	<html lang="en">
		<head>
			<meta charset="utf-8" />
			<title>Redirecting…</title>
			<meta http-equiv="refresh" content={`0;url=${redirectTo}`} />
			<link rel="canonical" href={new URL(redirectTo, Astro.site)} />
			<meta name="robots" content="noindex" />
		</head>
		<body data-pagefind-ignore="all">
			<p>This post has moved to <a href={redirectTo}>{redirectTo}</a>.</p>
		</body>
	</html>
) : (
	<PostLayout
		title={post.data.title}
		date={new Date(post.data.date)}
		updated={post.data.updated ? new Date(post.data.updated) : undefined}
		slug={postSlug(post.id)}
		categories={post.data.categories}
		tags={post.data.tags}
		cover={post.data.cover}
		description={post.data.summary || post.data.description}
		prevPost={prevPost}
		nextPost={nextPost}
		relatedPosts={relatedPosts}
		headings={rendered?.headings ?? []}
	>
		{Content && <Content />}
	</PostLayout>
)}
