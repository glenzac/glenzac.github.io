---
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { postSlug } from '../../utils/postSlug';
import { readingTime } from '../../utils/readingTime';
import { POSTS_PER_PAGE } from '../../consts';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = await getCollection('posts', ({ data }) => !data.draft);
	const sorted = posts.sort(
		(a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
	);
	// Page 1 is the homepage; only generate /page/2 onwards.
	return paginate(sorted, { pageSize: POSTS_PER_PAGE }).filter(
		({ params }) => Number(params.page) > 1
	);
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<'posts'>>;
}

const { page } = Astro.props;
const prevUrl = page.currentPage === 2 ? '/' : page.url.prev;
---

<BaseLayout title={`Posts — page ${page.currentPage}`}>
	<section class="recent-posts">
		<h2>Posts <span class="page-indicator">page {page.currentPage} of {page.lastPage}</span></h2>
		<div class="posts-grid">
			{page.data.map(post => (
				<PostCard
					title={post.data.title}
					date={new Date(post.data.date)}
					slug={postSlug(post.id)}
					categories={post.data.categories}
					cover={post.data.cover}
					summary={post.data.summary || post.data.description}
					readingTime={readingTime(post.body ?? '')}
				/>
			))}
		</div>
		<nav class="pagination">
			{prevUrl ? <a href={prevUrl}>← Newer posts</a> : <span />}
			{page.url.next ? <a href={page.url.next}>Older posts →</a> : <span />}
		</nav>
	</section>
</BaseLayout>

<style>
	.recent-posts h2 {
		font-size: 1.5rem;
		margin-bottom: 1.5rem;
		padding-bottom: 0.5rem;
		border-bottom: 2px solid var(--accent);
		color: var(--text-primary);
	}
	.page-indicator {
		font-size: 0.9rem;
		font-weight: 400;
		color: var(--text-muted);
		margin-left: 0.5rem;
	}
	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.5rem;
	}
	.pagination {
		display: flex;
		justify-content: space-between;
		margin-top: 2rem;
	}
	.pagination a {
		color: var(--accent);
		font-weight: 500;
		text-decoration: none;
	}
	.pagination a:hover {
		text-decoration: underline;
	}
</style>
