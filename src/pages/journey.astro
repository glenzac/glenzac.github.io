---
import BaseLayout from '../layouts/BaseLayout.astro';
import journey from '../data/journey.json';

const { totals, yearly, monthly, milestones, top_posts, countries, search_terms } = journey;

const fmt = (n: number) => n.toLocaleString('en-US');
const years = Math.round(
	(Date.now() - new Date(totals.first_day).valueOf()) / (365.25 * 24 * 3600 * 1000)
);

// ---- yearly bar chart (SVG) ----
const chartW = 720;
const chartH = 260;
const pad = { top: 16, right: 8, bottom: 28, left: 8 };
const maxYearViews = Math.max(...yearly.map((y) => y[1] as number));
const barBand = (chartW - pad.left - pad.right) / yearly.length;
const bars = yearly.map(([year, views], i) => {
	const h = ((views as number) / maxYearViews) * (chartH - pad.top - pad.bottom);
	return {
		year,
		views: views as number,
		x: pad.left + i * barBand + barBand * 0.15,
		w: barBand * 0.7,
		y: chartH - pad.bottom - h,
		h,
	};
});

// ---- monthly area chart (SVG) ----
const areaW = 720;
const areaH = 160;
const maxMonth = Math.max(...monthly.map((m) => m[1] as number));
const px = (i: number) => (i / (monthly.length - 1)) * areaW;
const py = (v: number) => areaH - (v / maxMonth) * (areaH - 10);
const linePts = monthly.map((m, i) => `${px(i).toFixed(1)},${py(m[1] as number).toFixed(1)}`).join(' ');
const areaPts = `0,${areaH} ${linePts} ${areaW},${areaH}`;
const peakIdx = monthly.findIndex((m) => m[1] === maxMonth);
const peakMonth = new Date(monthly[peakIdx][0] as string)
	.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });

// ---- top posts / countries bars ----
const maxPost = top_posts[0][1] as number;
const maxCountry = countries[0][1] as number;

const milestoneLabels: Record<number, string> = {
	1: 'First ever view',
	1000: '1,000 views',
	5000: '5,000 views',
	10000: '10,000 views',
	25000: '25,000 views',
	50000: '50,000 views',
};
const prettyDate = (d: string) =>
	new Date(d).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const description = `${years} years of blogging: ${fmt(totals.views)} views from ${fmt(totals.visitors)} readers across ${totals.countries} countries.`;
---

<BaseLayout title="Journey" description={description} showSidebar={false}>
	<article class="journey">
		<header class="hero">
			<p class="eyebrow">2015 — {new Date().getFullYear()}</p>
			<h1>The journey so far</h1>
			<p class="lede">
				This blog started on WordPress in 2015 and moved to this site in 2026.
				These numbers are its first {years} years — frozen at the move as a
				reminder of every reader it helped along the way.
			</p>
		</header>

		<section class="big-numbers" aria-label="Lifetime totals">
			<div class="stat"><span class="num">{fmt(totals.views)}</span><span class="label">views</span></div>
			<div class="stat"><span class="num">{fmt(totals.visitors)}</span><span class="label">visitors</span></div>
			<div class="stat"><span class="num">{totals.countries}</span><span class="label">countries</span></div>
			<div class="stat"><span class="num">{fmt(totals.posts)}</span><span class="label">posts</span></div>
			<div class="stat"><span class="num">{fmt(totals.shares)}</span><span class="label">shares</span></div>
			<div class="stat"><span class="num">{fmt(totals.followers)}</span><span class="label">followers</span></div>
		</section>

		<section>
			<h2>Views by year</h2>
			<svg viewBox={`0 0 ${chartW} ${chartH}`} role="img" aria-label="Bar chart of views per year" class="chart">
				{bars.map((b) => (
					<g>
						<rect x={b.x} y={b.y} width={b.w} height={b.h} rx="3" class="bar" />
						<text x={b.x + b.w / 2} y={b.y - 5} text-anchor="middle" class="bar-value">
							{b.views >= 1000 ? `${(b.views / 1000).toFixed(1)}k` : b.views}
						</text>
						<text x={b.x + b.w / 2} y={chartH - 8} text-anchor="middle" class="bar-label">
							{String(b.year).slice(2)}
						</text>
					</g>
				))}
			</svg>
		</section>

		<section>
			<h2>Every month, {new Date(totals.first_day).getFullYear()}–{new Date().getFullYear()}</h2>
			<svg viewBox={`0 0 ${areaW} ${areaH}`} role="img" aria-label="Area chart of monthly views" class="chart" preserveAspectRatio="none">
				<polygon points={areaPts} class="area" />
				<polyline points={linePts} class="line" fill="none" />
			</svg>
			<p class="chart-note">
				Peak month: <strong>{peakMonth}</strong> with {fmt(maxMonth)} views ·
				best single day: <strong>{prettyDate(totals.best_day)}</strong> with {fmt(totals.best_day_views)} views
			</p>
		</section>

		<section>
			<h2>Milestones</h2>
			<ol class="timeline">
				{milestones.map(([n, date]) => (
					<li>
						<span class="tl-date">{prettyDate(date as string)}</span>
						<span class="tl-what">{milestoneLabels[n as number] ?? `${fmt(n as number)} views`}</span>
					</li>
				))}
				<li>
					<span class="tl-date">July 2026</span>
					<span class="tl-what">The blog moves here — new home, same tinkering</span>
				</li>
			</ol>
		</section>

		<section>
			<h2>The posts that helped the most people</h2>
			<ul class="ranked">
				{top_posts.map(([title, views, slug]) => (
					<li>
						<a href={`/posts/${slug}/`}>{title}</a>
						<div class="track"><div class="fill" style={`width:${((views as number) / maxPost) * 100}%`} /></div>
						<span class="value">{fmt(views as number)}</span>
					</li>
				))}
			</ul>
		</section>

		<section>
			<h2>Where readers came from</h2>
			<ul class="ranked">
				{countries.map(([name, views]) => (
					<li>
						<span class="country">{name}</span>
						<div class="track"><div class="fill" style={`width:${((views as number) / maxCountry) * 100}%`} /></div>
						<span class="value">{fmt(views as number)}</span>
					</li>
				))}
			</ul>
			<p class="chart-note">…and {totals.countries - countries.length} more countries.</p>
		</section>

		<section>
			<h2>What people were searching for</h2>
			<ul class="terms">
				{search_terms.map(([term]) => <li>“{term}”</li>)}
			</ul>
			<p class="chart-note">
				(Search engines hide most terms these days — these are the rare visible ones.)
			</p>
		</section>

		<footer class="journey-footer">
			<p>
				Data archived from WordPress.com stats at migration time.
				The journey continues at <a href="/">glenzac.github.io</a>.
			</p>
		</footer>
	</article>
</BaseLayout>

<style>
	.journey {
		max-width: 760px;
		margin: 0 auto;
	}
	.hero {
		text-align: center;
		margin: 1rem 0 3rem;
	}
	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.15em;
		font-size: 0.8rem;
		color: var(--accent);
		margin-bottom: 0.5rem;
	}
	.hero h1 {
		font-size: 2.5rem;
		margin: 0 0 1rem;
		color: var(--text-primary);
	}
	.lede {
		color: var(--text-secondary);
		font-size: 1.1rem;
		line-height: 1.7;
		max-width: 34rem;
		margin: 0 auto;
	}
	.big-numbers {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		margin-bottom: 3rem;
	}
	.stat {
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 10px;
		padding: 1.25rem 0.5rem;
		text-align: center;
	}
	.stat .num {
		display: block;
		font-size: 1.9rem;
		font-weight: 700;
		color: var(--accent);
		line-height: 1.1;
	}
	.stat .label {
		color: var(--text-muted);
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	section {
		margin-bottom: 3rem;
	}
	h2 {
		font-size: 1.35rem;
		color: var(--text-primary);
		border-bottom: 2px solid var(--accent);
		padding-bottom: 0.5rem;
		margin-bottom: 1.25rem;
	}
	.chart {
		width: 100%;
		height: auto;
	}
	.bar {
		fill: var(--accent);
		opacity: 0.85;
	}
	.bar-value {
		font-size: 11px;
		fill: var(--text-muted);
	}
	.bar-label {
		font-size: 11px;
		fill: var(--text-muted);
	}
	.area {
		fill: var(--accent);
		opacity: 0.15;
	}
	.line {
		stroke: var(--accent);
		stroke-width: 1.5;
	}
	.chart-note {
		color: var(--text-muted);
		font-size: 0.9rem;
		margin-top: 0.75rem;
	}
	.timeline {
		list-style: none;
		padding: 0;
		margin: 0;
		border-left: 2px solid var(--accent);
	}
	.timeline li {
		position: relative;
		padding: 0 0 1.25rem 1.5rem;
	}
	.timeline li::before {
		content: '';
		position: absolute;
		left: -7px;
		top: 0.3rem;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--accent);
	}
	.tl-date {
		display: block;
		font-size: 0.85rem;
		color: var(--text-muted);
	}
	.tl-what {
		color: var(--text-primary);
		font-weight: 500;
	}
	.ranked {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}
	.ranked li {
		display: grid;
		grid-template-columns: minmax(0, 2fr) 3fr auto;
		align-items: center;
		gap: 0.75rem;
	}
	.ranked a,
	.ranked .country {
		color: var(--text-primary);
		font-size: 0.95rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.ranked a:hover {
		color: var(--accent);
	}
	.track {
		background: var(--bg-secondary);
		border-radius: 4px;
		height: 10px;
		overflow: hidden;
	}
	.fill {
		background: var(--accent);
		height: 100%;
		border-radius: 4px;
	}
	.value {
		color: var(--text-muted);
		font-size: 0.85rem;
		font-variant-numeric: tabular-nums;
	}
	.terms {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.terms li {
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 15px;
		padding: 0.3rem 0.9rem;
		font-size: 0.9rem;
		color: var(--text-secondary);
		font-style: italic;
	}
	.journey-footer {
		text-align: center;
		color: var(--text-muted);
		font-size: 0.9rem;
		border-top: 1px solid var(--border-color);
		padding-top: 1.5rem;
	}
	.journey-footer a {
		color: var(--accent);
	}
	@media (max-width: 640px) {
		.big-numbers {
			grid-template-columns: repeat(2, 1fr);
		}
		.hero h1 {
			font-size: 1.9rem;
		}
		.ranked li {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
	}
</style>
