---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'about');
const { Content } = await render(page);
---

<BaseLayout title="About">
	<article class="page">
		<div class="prose">
			<Content />
		</div>
	</article>
</BaseLayout>

<style>
	.prose {
		background: var(--bg-primary);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		padding: 2rem;
		line-height: 1.8;
	}
	.prose :global(h2) {
		font-size: 1.5rem;
		margin-top: 0;
		margin-bottom: 1rem;
		color: var(--text-primary);
	}
	.prose :global(h2 + h2),
	.prose :global(p + h2) {
		margin-top: 2rem;
	}
	.prose :global(h3) {
		font-size: 1.25rem;
		margin-top: 1.5rem;
		margin-bottom: 0.75rem;
	}
	.prose :global(p) {
		margin-bottom: 1rem;
		color: var(--text-secondary);
	}
	.prose :global(ul),
	.prose :global(ol) {
		margin-bottom: 1.25rem;
		color: var(--text-secondary);
	}
	.prose :global(a) {
		color: var(--accent);
	}
	.prose :global(strong) {
		color: var(--text-primary);
		font-weight: 600;
	}
</style>
