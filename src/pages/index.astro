---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { postSlug } from '../utils/postSlug';
import { SITE_DESCRIPTION, POSTS_PER_PAGE } from '../consts';
import { readingTime } from '../utils/readingTime';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const recentPosts = posts
	.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
	.slice(0, POSTS_PER_PAGE);
---

<BaseLayout>
	<section class="home-intro">
		<h1>Hi, I'm Glen 👋</h1>
		<p>{SITE_DESCRIPTION} — electronics tinkering, open-source software, and the occasional opinion.</p>
	</section>
	<section class="recent-posts">
		<h2>Latest posts</h2>
		<div class="posts-grid">
			{recentPosts.map(post => (
				<PostCard
					title={post.data.title}
					date={new Date(post.data.date)}
					slug={postSlug(post.id)}
					categories={post.data.categories}
					cover={post.data.cover}
					summary={post.data.summary || post.data.description}
					readingTime={readingTime(post.body ?? '')}
				/>
			))}
		</div>
		<div class="all-posts-link">
			<a href="/page/2" class="older-posts">Older posts →</a>
			<a href="/archives">Browse all {posts.length} posts</a>
		</div>
	</section>
</BaseLayout>

<style>
	.home-intro {
		margin-bottom: 2.5rem;
	}
	.home-intro h1 {
		font-size: 2rem;
		margin-bottom: 0.5rem;
		color: var(--text-primary);
	}
	.home-intro p {
		color: var(--text-secondary);
		font-size: 1.05rem;
		line-height: 1.7;
	}
	.recent-posts h2 {
		font-size: 1.5rem;
		margin-bottom: 1.5rem;
		padding-bottom: 0.5rem;
		border-bottom: 2px solid var(--accent);
		color: var(--text-primary);
	}
	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.5rem;
	}
	.all-posts-link {
		margin-top: 2rem;
		display: flex;
		justify-content: center;
		gap: 2rem;
	}
	.all-posts-link a {
		color: var(--accent);
		font-weight: 500;
		text-decoration: none;
	}
	.all-posts-link a:hover {
		text-decoration: underline;
	}
</style>
